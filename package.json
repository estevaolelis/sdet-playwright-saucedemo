{
  "name": "sdet-playwright-saucedemo",
  "version": "1.0.0",
  "description": "End-to-end test automation for SauceDemo with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test --grep \"@regression\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "report:allure": "allure generate allure-results --output allure-report && allure open allure-report",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estevaolelis/sdet-playwright-saucedemo.git"
  },
  "keywords": [
    "playwright",
    "typescript",
    "sdet",
    "e2e",
    "page-object"
  ],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/estevaolelis/sdet-playwright-saucedemo/issues"
  },
  "homepage": "https://github.com/estevaolelis/sdet-playwright-saucedemo#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
